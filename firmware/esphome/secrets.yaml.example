# Copy to secrets.yaml (gitignored) and fill in.
#   cp secrets.yaml.example secrets.yaml
wifi_ssid: "your-ssid"
wifi_password: "your-password"

# Used by vsp-wsc4-standalone.yaml (the production config), not by the
# bring-up config, which deliberately runs without API encryption.
api_key: "generate at https://esphome.io/components/api.html"
ota_password: "choose-one"
