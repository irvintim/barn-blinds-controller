# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# IDE / agent local state
.idea/
.vscode/
.history/
.junie/
.claude/settings.local.json

# KiCad - transient/regenerable, not design source
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_prl
~*.lck
_autosave-*
*-backups/
fp-info-cache
*-drc.rpt
*-erc.rpt

# Fabrication Toolkit writes into pcb/main-board/production/ on every run.
# That is scratch: copy the outputs you actually order from into
# pcb/main-board/fab/vsp-wsc4-revX.Y/ and commit them there.
pcb/main-board/production/

# FreeCAD backups/autosave - git history is the backup
*.FCBak
*.FCStd1

# ESPHome build output and secrets (copy secrets.yaml in by hand, never commit it)
firmware/esphome/.esphome/
firmware/esphome/secrets.yaml
secrets.yaml

# Stock upstream Tasmota release binary - redownload from
# https://ota.tasmota.com/tasmota32/release/tasmota32s3.factory.bin
tasmota32s3.factory.bin

# Python venv for esphome/esptool
venv/
.venv/
